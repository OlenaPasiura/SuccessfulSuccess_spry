# Copy to .env and configure before deployment

# --- Local Docker Compose settings --------------------------------------------
POSTGRES_DB=spry
POSTGRES_USER=spry
POSTGRES_PASSWORD=spry_secret
DATABASE_URL=postgresql://spry:spry_secret@postgres:5432/spry
CORS_ALLOWED_ORIGINS=http://localhost:5173
VITE_API_URL=http://localhost:8000

# --- AWS Deployment Settings & Credentials -----------------------------------
# Fill these in your own .env (which is gitignored) - never commit secrets!
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN is only required for temporary credentials (e.g. AWS Academy or SSO)
AWS_SESSION_TOKEN=
AWS_REGION=us-east-1

# Project name prefix for AWS resources (ECR, ECS, S3, CloudFront, ALB)
PROJECT_NAME=successfulsuccess
IMAGE_TAG=latest

# Database URL used in ECS Fargate:
# Defaults to local SQLite file inside Fargate task container if left blank,
# or specify an external PostgreSQL / Amazon RDS database connection string.
# DATABASE_URL=sqlite:////app/meetings.db
